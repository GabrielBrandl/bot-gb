FROM node:22-alpine AS base
RUN apk add --no-cache openssl libc6-compat \
 && corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
RUN pnpm --filter @bot-wpp/shared-types build \
 && pnpm --filter @bot-wpp/database generate \
 && pnpm --filter @bot-wpp/database build \
 && pnpm --filter @bot-wpp/api build

FROM node:22-alpine AS runner
RUN apk add --no-cache openssl libc6-compat wget \
 && corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
ENV NODE_ENV=production
ENV API_PORT=3000
COPY --from=build /app /app
COPY docker/api-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
WORKDIR /app/apps/api
EXPOSE 3000
# EasyPanel / LB: bind is 0.0.0.0 inside the process (see main.ts)
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
ENTRYPOINT ["/entrypoint.sh"]
