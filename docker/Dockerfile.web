# Web estático — assets pré-compilados em docker/web-prebuilt
# (evita OOM no EasyPanel ao buildar Vite/Node no servidor).
#
# Atualizar assets:
#   VITE_API_URL=https://bot-gb-api.9nb5f0.easypanel.host/api \
#   VITE_WS_URL=https://bot-gb-api.9nb5f0.easypanel.host \
#   pnpm --filter @bot-wpp/web build
#   rm -rf docker/web-prebuilt && mkdir -p docker/web-prebuilt && cp -r apps/web/dist/* docker/web-prebuilt/
#
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/web-prebuilt /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
