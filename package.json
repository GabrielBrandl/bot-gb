{
  "name": "bot-gb",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bot-wpp/database generate",
    "db:migrate": "pnpm --filter @bot-wpp/database migrate:dev",
    "db:push": "pnpm --filter @bot-wpp/database push",
    "db:seed": "pnpm --filter @bot-wpp/database seed"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
