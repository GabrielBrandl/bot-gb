# =============================================================================
# EasyPanel — copie estas variáveis no Environment / createDotEnv do projeto
# Substitua SEUDOMINIO e todas as SENHAS antes de subir.
# Compose: docker-compose.easypanel.yml (raiz)
# =============================================================================

# --- Domínios públicos (HTTPS no EasyPanel / Traefik) -------------------------
# web  → https://app.SEUDOMINIO.com
# api  → https://api.SEUDOMINIO.com   (habilite WebSocket)
# evo  → https://evo.SEUDOMINIO.com

CORS_ORIGIN=https://app.SEUDOMINIO.com
PUBLIC_API_URL=https://api.SEUDOMINIO.com
EVOLUTION_SERVER_URL=https://evo.SEUDOMINIO.com
EVOLUTION_WEBHOOK_URL=https://api.SEUDOMINIO.com/api/whatsapp/webhook

# Build args do frontend (obrigatório rebuild do serviço `web` se mudar)
VITE_API_URL=https://api.SEUDOMINIO.com/api
VITE_WS_URL=https://api.SEUDOMINIO.com

# --- Postgres (serviço interno do compose) -----------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_SENHA_FORTE_POSTGRES
POSTGRES_DB=bot_wpp

# Se usar o Postgres do compose, pode deixar assim (senha = POSTGRES_PASSWORD):
DATABASE_URL=postgresql://postgres:TROQUE_SENHA_FORTE_POSTGRES@postgres:5432/bot_wpp?schema=public
DIRECT_URL=postgresql://postgres:TROQUE_SENHA_FORTE_POSTGRES@postgres:5432/bot_wpp?schema=public
EVOLUTION_DATABASE_URI=postgresql://postgres:TROQUE_SENHA_FORTE_POSTGRES@postgres:5432/evolution?schema=public

# Alternativa Supabase (aí remova/ignore o serviço postgres no painel):
# DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?schema=public&sslmode=require
# DIRECT_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres?sslmode=require
# EVOLUTION_DATABASE_URI=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/evolution?schema=public&sslmode=require

# --- Secrets (obrigatórios em produção) --------------------------------------
# JWT: mínimo 32 caracteres aleatórios
JWT_SECRET=TROQUE_JWT_COM_PELO_MENOS_32_CARACTERES_ALEATORIOS
JWT_EXPIRES_IN=7d

# Mesma chave na Evolution e na API
EVOLUTION_API_KEY=TROQUE_CHAVE_EVOLUTION_LONGA
# URL que a API usa para falar com a Evolution (rede interna ou URL pública)
EVOLUTION_API_URL=http://evolution-api:8080
# Secret enviado no header x-webhook-secret / apikey pela Evolution
EVOLUTION_WEBHOOK_SECRET=TROQUE_WEBHOOK_SECRET_LONGO

# --- Opcional: pagamentos / IA / Instagram -----------------------------------
ASAAS_API_URL=https://api.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
