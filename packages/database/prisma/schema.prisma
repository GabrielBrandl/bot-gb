generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: set DIRECT_URL to the direct DB host for migrations (port 5432).
  // Local Docker: use the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PLATFORM_OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum Channel {
  WHATSAPP
  INSTAGRAM
}

enum PlanCode {
  STARTER
  PRO
  ENTERPRISE
}

model Plan {
  id              String   @id
  code            PlanCode @unique
  name            String
  description     String
  priceMonthly    Decimal  @db.Decimal(12, 2)
  priceYearly     Decimal  @db.Decimal(12, 2)
  maxAgents       Int
  maxWhatsapp     Int
  maxInstagram    Int
  maxContacts     Int
  maxFlows        Int
  maxCampaigns    Int
  aiEnabled       Boolean  @default(false)
  instagramEnabled Boolean @default(false)
  campaignsEnabled Boolean @default(false)
  paymentsEnabled Boolean  @default(false)
  reportsEnabled  Boolean  @default(true)
  whiteLabel      Boolean  @default(false)
  prioritySupport Boolean  @default(false)
  features        Json
  highlight       Boolean  @default(false)
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

model Tenant {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  logoUrl        String?
  primaryColor   String?   @default("#3B82F6")
  planId         String    @default("STARTER")
  planRef        Plan      @relation(fields: [planId], references: [id])
  plan           String    @default("STARTER")
  maxAgents      Int       @default(2)
  maxInstances   Int       @default(1)
  maxInstagram   Int       @default(0)
  maxContacts    Int       @default(500)
  billingStatus  String    @default("trialing")
  trialEndsAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users               User[]
  contacts            Contact[]
  instances           WhatsappInstance[]
  instagramAccounts   InstagramAccount[]
  tags                Tag[]
  boards              KanbanBoard[]
  flows               Flow[]
  campaigns           Campaign[]
  payments            Payment[]
  aiAgents            AIAgent[]
  quickReplies        QuickReply[]
  conversations       Conversation[]
  auditLogs           AuditLog[]
  knowledgeDocuments  KnowledgeDocument[]
  businessHours       BusinessHours?

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedConversations Conversation[] @relation("AssignedAgent")
  sentMessages          Message[]      @relation("MessageSender")

  @@index([tenantId])
  @@map("users")
}

model WhatsappInstance {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  evolutionInstanceId String
  phoneNumber         String?
  status              String   @default("disconnected")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversations Conversation[]

  @@unique([tenantId, evolutionInstanceId])
  @@index([tenantId])
  @@map("whatsapp_instances")
}

model InstagramAccount {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  igUserId        String
  igUsername      String?
  pageId          String?
  accessTokenEnc  String?
  status          String   @default("disconnected")
  webhookVerify   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversations Conversation[]

  @@unique([tenantId, igUserId])
  @@index([tenantId])
  @@map("instagram_accounts")
}

model Contact {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String?
  phone        String?
  instagramId  String?
  username     String?
  avatarUrl    String?
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags               Tag[]
  conversations      Conversation[]
  kanbanCards        KanbanCard[]
  payments           Payment[]
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, phone])
  @@unique([tenantId, instagramId])
  @@index([tenantId])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#8B5CF6")
  createdAt DateTime @default(now())

  contacts Contact[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model Conversation {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId          String
  contact            Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel            Channel           @default(WHATSAPP)
  instanceId         String?
  instance           WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  instagramAccountId String?
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)
  assignedTo         String?
  assignee           User?             @relation("AssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  status             String            @default("open")
  csatScore          Int?
  lastMessageAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  messages    Message[]
  kanbanCards KanbanCard[]

  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, assignedTo])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  type           String       @default("text")
  content        String
  mediaUrl       String?
  externalId     String?
  isInternal     Boolean      @default(false)
  channel        Channel      @default(WHATSAPP)
  sentByUserId   String?
  sentBy         User?        @relation("MessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([tenantId, externalId])
  @@index([sentByUserId])
  @@map("messages")
}

model BusinessHours {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone  String   @default("America/Manaus")
  schedule  Json
  awayMessage String @default("Obrigado pelo contato! Nosso horário de atendimento é de segunda a sexta, 8h às 18h. Retornaremos em breve.")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

model KanbanBoard {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages KanbanStage[]

  @@index([tenantId])
  @@map("kanban_boards")
}

model KanbanStage {
  id        String      @id @default(cuid())
  tenantId  String
  boardId   String
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime    @default(now())

  cards KanbanCard[]

  @@index([boardId, order])
  @@index([tenantId])
  @@map("kanban_stages")
}

model KanbanCard {
  id             String        @id @default(cuid())
  tenantId       String
  stageId        String
  stage          KanbanStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String?
  dealValue      Decimal?      @db.Decimal(12, 2)
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([stageId, order])
  @@index([tenantId])
  @@index([contactId])
  @@map("kanban_cards")
}

model Flow {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  channel   Channel? 
  nodes     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@map("flows")
}

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  message     String
  channel     Channel   @default(WHATSAPP)
  tagIds      Json?
  stageId     String?
  scheduledAt DateTime?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  tenantId   String
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  error      String?
  sentAt     DateTime?

  @@index([campaignId, status])
  @@index([tenantId])
  @@map("campaign_recipients")
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("pending")
  gateway     String   @default("asaas")
  billingType String   @default("UNDEFINED")
  description String?
  externalId  String?
  link        String?
  bankSlipUrl String?
  invoiceUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([contactId])
  @@map("payments")
}

model AIAgent {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  persona         String
  modelProvider   String
  apiKeyEncrypted String?
  systemPrompt    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeDocuments KnowledgeDocument[]

  @@index([tenantId])
  @@map("ai_agents")
}

model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortcut  String
  title     String
  content   String
  channel   Channel?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, shortcut])
  @@index([tenantId])
  @@map("quick_replies")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     AIAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title     String
  content   String
  createdAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  tenantId   String
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Json

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}
