generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: set DIRECT_URL to the direct DB host for migrations (port 5432).
  // Local Docker: use the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}


enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String?  @default("#0033B5")
  plan         String   @default("STARTER")
  maxAgents    Int      @default(3)
  maxInstances Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  contacts            Contact[]
  instances           WhatsappInstance[]
  tags                Tag[]
  boards              KanbanBoard[]
  flows               Flow[]
  campaigns           Campaign[]
  payments            Payment[]
  aiAgents            AIAgent[]
  quickReplies        QuickReply[]
  conversations       Conversation[]
  auditLogs           AuditLog[]
  knowledgeDocuments  KnowledgeDocument[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedConversations Conversation[] @relation("AssignedAgent")

  @@index([tenantId])
  @@map("users")
}

model WhatsappInstance {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  evolutionInstanceId String
  phoneNumber         String?
  status              String   @default("disconnected")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  conversations Conversation[]

  @@unique([tenantId, evolutionInstanceId])
  @@index([tenantId])
  @@map("whatsapp_instances")
}

model Contact {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String?
  phone        String
  customFields Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags          Tag[]
  conversations Conversation[]
  kanbanCards   KanbanCard[]
  payments      Payment[]
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now())

  contacts Contact[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  instanceId    String?
  instance      WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  assignedTo    String?
  assignee      User?    @relation("AssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  status        String   @default("open")
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages    Message[]
  kanbanCards KanbanCard[]

  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  type           String   @default("text")
  content        String
  mediaUrl       String?
  externalId     String?
  isInternal     Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("messages")
}

model KanbanBoard {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages KanbanStage[]

  @@index([tenantId])
  @@map("kanban_boards")
}

model KanbanStage {
  id        String   @id @default(cuid())
  tenantId  String
  boardId   String
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  createdAt DateTime @default(now())

  cards KanbanCard[]

  @@index([boardId, order])
  @@index([tenantId])
  @@map("kanban_stages")
}

model KanbanCard {
  id             String   @id @default(cuid())
  tenantId       String
  stageId        String
  stage          KanbanStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title          String?
  dealValue      Decimal? @db.Decimal(12, 2)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([stageId, order])
  @@index([tenantId])
  @@index([contactId])
  @@map("kanban_cards")
}

model Flow {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  trigger   String
  nodes     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@map("flows")
}

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  message     String
  tagIds      Json?
  stageId     String?
  scheduledAt DateTime?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients CampaignRecipient[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  tenantId   String
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  error      String?
  sentAt     DateTime?

  @@index([campaignId, status])
  @@index([tenantId])
  @@map("campaign_recipients")
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("pending")
  gateway     String   @default("asaas")
  billingType String   @default("UNDEFINED")
  description String?
  externalId  String?
  link        String?
  bankSlipUrl String?
  invoiceUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([contactId])
  @@map("payments")
}

model AIAgent {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  persona         String
  modelProvider   String
  apiKeyEncrypted String?
  systemPrompt    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeDocuments KnowledgeDocument[]

  @@index([tenantId])
  @@map("ai_agents")
}

model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortcut  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, shortcut])
  @@index([tenantId])
  @@map("quick_replies")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     AIAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title     String
  content   String
  createdAt DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([tenantId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  tenantId   String
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Json

  @@index([tenantId])
  @@index([documentId])
  @@map("knowledge_chunks")
}
