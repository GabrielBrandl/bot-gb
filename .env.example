# =============================================================================
# Database (local Docker OR Supabase / EasyPanel)
# =============================================================================
# Local Docker (default) — compose maps Postgres→5433 and Redis→6380
# to avoid clashing with Windows PostgreSQL/Redis on 5432/6379.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/bot_wpp?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/bot_wpp?schema=public

# Supabase / EasyPanel (production) — Project Settings → Database → URI
# SSL is required. Prisma needs sslmode=require:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=public&sslmode=require
# DIRECT_URL (migrations): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# EasyPanel Postgres interno (opcional, se NÃO usar Supabase):
# DATABASE_URL=postgresql://postgres:SENHA@postgres:5432/bot_wpp?schema=public
# DIRECT_URL=postgresql://postgres:SENHA@postgres:5432/bot_wpp?schema=public

# Redis (Docker host port 6380; EasyPanel / compose network: host `redis` port 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# EasyPanel: REDIS_HOST=redis  REDIS_PORT=6379

# API
API_PORT=3000
API_PREFIX=api
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# EasyPanel: CORS_ORIGIN=https://app.seudominio.com

# URL pública da API (EasyPanel) — base dos webhooks (sem barra no final)
# PUBLIC_API_URL=https://api.seudominio.com

# Evolution API (WhatsApp) — Docker local ou serviço EasyPanel
EVOLUTION_API_URL=http://localhost:8080
# EasyPanel (rede interna): EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=dev-evolution-key
# Local (Evolution no Docker → API no host):
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/webhook
# EasyPanel (URL PÚBLICA — use PUBLIC_API_URL):
# EVOLUTION_WEBHOOK_URL=https://api.seudominio.com/api/whatsapp/webhook
EVOLUTION_WEBHOOK_SECRET=

# AI Providers (optional; without keys the agent uses fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ASAAS (sandbox or production)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Produção: ASAAS_API_URL=https://api.asaas.com/api/v3
ASAAS_API_KEY=
# Sem chave = modo demo (links placeholder). Webhook público:
# ${PUBLIC_API_URL}/api/payments/webhook/asaas
# → https://api.seudominio.com/api/payments/webhook/asaas
# Display-only bank info (non-secret) — never put the API key in source
ASAAS_BANK_CODE=461
ASAAS_BANK_NAME=Asaas I.P S.A
ASAAS_AGENCY=0001
ASAAS_ACCOUNT=
ASAAS_CONTACT_EMAIL=
TENANT_CNPJ=

# Frontend (build-time for Vite / Docker web image / EasyPanel build args)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
# EasyPanel build args:
# VITE_API_URL=https://api.seudominio.com/api
# VITE_WS_URL=https://api.seudominio.com
