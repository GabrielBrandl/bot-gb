# =============================================================================
# Database (local Docker OR Supabase)
# =============================================================================
# Local Docker (default) — compose maps Postgres→5433 and Redis→6380
# to avoid clashing with Windows PostgreSQL/Redis on 5432/6379.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/bot_wpp?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5433/bot_wpp?schema=public

# Supabase (production) — Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler (port 6543) for the API, or Session/direct (5432).
# SSL is required. Prisma needs sslmode=require:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?schema=public&sslmode=require
# For migrations (Prisma migrate), prefer the direct host (db.*.supabase.co:5432) with sslmode=require:
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Redis (Docker host port 6380; inside compose network use host `redis` port 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# API
API_PORT=3000
API_PREFIX=api
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Evolution API (WhatsApp) — Docker service or EasyPanel app
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-evolution-key
EVOLUTION_WEBHOOK_SECRET=

# AI Providers (optional; without keys the agent uses fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ASAAS (sandbox or production)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

# Frontend (build-time for Vite / Docker web image)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
